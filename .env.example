# .env.example — variables d'environnement pour Plotline
# Copiez ce fichier en .env ou .env.local puis remplissez les valeurs.
# NE PAS COMMITER votre vrai .env contenant des secrets.

# Chaîne de connexion PostgreSQL (remplacez les valeurs)
# Exemple: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/plotline?schema=public

# Port de développement (optionnel)
PORT=3001

# Environnement par défaut
NODE_ENV=development
