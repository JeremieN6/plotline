generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  SOLO
  STUDIO
  AGENCY
}

enum AccountType {
  INFLUENCER_CREATOR
  CONTENT_CREATOR
  BRAND
}

enum ProfileType {
  PERSONA
  BRAND
  ACTIVITY
}

enum ContentPlatform {
  INSTAGRAM
  TIKTOK
  BOTH
}

enum ContentFormat {
  FEED
  STORY
  REEL
}

enum ContentStatus {
  PROCESSING
  PENDING
  VALIDATED
  PUBLISHED
  REJECTED
  FAILED
}

enum PlanStatus {
  DRAFT
  APPROVED
  DISCARDED
}

enum SilhouetteType {
  SLIM
  ATHLETIC
  CURVY
  VOLUPTUOUS
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String?
  plan         Plan          @default(SOLO)
  accountType  AccountType?
  createdAt    DateTime      @default(now())
  influencers  Profile[]
  campaigns    Campaign[]
  authSessions AuthSession[]
  passwordResetTokens PasswordResetToken[]
  emailChangeTokens   EmailChangeToken[]
}

model Campaign {
  id         String   @id @default(cuid())
  userId     String
  name       String
  objective  String?
  channel    String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedContents GeneratedContent[]
  contentPlans      ContentPlan[]

  @@index([userId, createdAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailChangeToken {
  id        String   @id @default(cuid())
  userId    String
  newEmail  String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([newEmail])
  @@index([expiresAt])
}

model Profile {
  id                   String             @id @default(cuid())
  userId               String
  name                 String
  niche                String
  style                String
  profileType          ProfileType?
  silhouette           SilhouetteType     @default(VOLUPTUOUS)
  brandId              String?
  faceRefPath          String?
  bodyPrompt           String?
  hairPrompt           String?
  identityProfile      String             @default("default")
  description          String?
  website              String?
  targetAudience       String?
  instagramAccountId   String?
  instagramAccessToken  String?
  twitterConnected     Boolean            @default(false)
  twitterUsername      String?
  tiktokEnabled        Boolean            @default(false)
  /// Position courante dans la rotation des formats, avancee a chaque plan.
  calendarStep         Int                @default(1)
  /// Cadence editoriale du profil: dans un compte agence, chaque influenceur a
  /// son propre rythme, independamment des campagnes.
  postsPerWeek         Int                @default(3)
  formatRotation       String             @default("FEED,STORY,REEL")
  publishHour          Int                @default(18)
  createdAt            DateTime           @default(now())

  user                 User               @relation(fields: [userId], references: [id])
  brand                Profile?           @relation("ProfileBrand", fields: [brandId], references: [id], onDelete: SetNull)
  brandInfluencers     Profile[]          @relation("ProfileBrand")
  generatedContents    GeneratedContent[]

  /// Liens quand ce profil est la marque, puis quand il est l ambassadrice.
  ambassadorLinks      BrandAmbassador[]  @relation("BrandLinkBrand")
  brandLinks           BrandAmbassador[]  @relation("BrandLinkAmbassador")
  contentPlans         ContentPlan[]

  @@map("Influencer")
}

/// Rattachement marque <-> ambassadrice. Une ambassadrice represente souvent
/// plusieurs marques: la colonne `Profile.brandId`, limitee a une seule, est
/// conservee en repli le temps que la migration soit passee partout.
model BrandAmbassador {
  id           String   @id @default(cuid())
  brandId      String
  ambassadorId String
  createdAt    DateTime @default(now())

  brand        Profile  @relation("BrandLinkBrand", fields: [brandId], references: [id], onDelete: Cascade)
  ambassador   Profile  @relation("BrandLinkAmbassador", fields: [ambassadorId], references: [id], onDelete: Cascade)

  @@unique([brandId, ambassadorId])
  @@index([ambassadorId])
}

model GeneratedContent {
  id            String         @id @default(cuid())
  influencerId  String
  brandId       String?
  ambassadorId  String?
  campaignId    String?
  imageUrl      String?
  caption       String?
  prompt        String?
  errorMessage  String?
  /// Regroupe les slides d un meme carrousel. Chaque slide reste un contenu
  /// autonome, avec son propre historique de versions et sa propre modification.
  carouselId       String?
  carouselPosition Int?
  platform      ContentPlatform @default(INSTAGRAM)
  format        ContentFormat
  status        ContentStatus   @default(PENDING)
  scheduledAt   DateTime?
  publishedAt   DateTime?
  twitterPublishedAt DateTime?
  createdAt     DateTime       @default(now())

  influencer    Profile        @relation(fields: [influencerId], references: [id])
  campaign      Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  versions      ContentVersion[]
  planItems     ContentPlanItem[]
}

/// Plan editorial: une liste d idees datees, relues AVANT que le moindre media
/// soit produit. Valider un texte coute une requete Claude, valider apres
/// generation coute autant de videos que d idees.
model ContentPlan {
  id         String     @id @default(cuid())
  profileId  String
  campaignId String?
  status     PlanStatus @default(DRAFT)
  startDate  DateTime
  days       Int        @default(7)
  createdAt  DateTime   @default(now())

  profile    Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  campaign   Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  items      ContentPlanItem[]

  @@index([profileId, createdAt])
}

/// Une idee du plan. `keep` permet de l ecarter a la revue sans la detruire,
/// `contentId` relie l idee au contenu produit une fois le plan approuve: on
/// sait ainsi ce qui a deja ete genere et on ne le refait pas deux fois.
model ContentPlanItem {
  id          String          @id @default(cuid())
  planId      String
  position    Int
  prompt      String
  caption     String?
  hashtags    String?
  platform    ContentPlatform @default(INSTAGRAM)
  format      ContentFormat
  scheduledAt DateTime
  keep        Boolean         @default(true)
  contentId   String?
  createdAt   DateTime        @default(now())

  plan        ContentPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  content     GeneratedContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([planId, position])
}

/// Historique des rendus successifs d un contenu.
/// GeneratedContent conserve toujours l etat courant (imageUrl/caption/prompt),
/// ce qui evite de toucher au code de publication et de listing. ContentVersion
/// stocke un instantane complet de chaque rendu pour permettre le retour arriere.
model ContentVersion {
  id              String   @id @default(cuid())
  contentId       String
  imageUrl        String?
  caption         String?
  prompt          String?
  generationModel String?
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())

  content         GeneratedContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, createdAt])
}
