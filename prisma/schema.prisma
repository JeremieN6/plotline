generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  SOLO
  STUDIO
  AGENCY
}

enum ContentPlatform {
  INSTAGRAM
  TIKTOK
  BOTH
}

enum ContentFormat {
  FEED
  STORY
  REEL
}

enum ContentStatus {
  PROCESSING
  PENDING
  VALIDATED
  PUBLISHED
  REJECTED
  FAILED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  plan         Plan          @default(SOLO)
  createdAt    DateTime      @default(now())
  influencers  Influencer[]
}

model Influencer {
  id                   String             @id @default(cuid())
  userId               String
  name                 String
  niche                String
  style                String
  faceRefPath          String?
  bodyRefPath          String?
  bodyPrompt           String?
  hairPrompt           String?
  hairAutoPrompt       String?
  hairLocked           Boolean            @default(true)
  identityProfile      String             @default("default")
  instagramAccountId   String?
  instagramAccessToken  String?
  tiktokEnabled        Boolean            @default(false)
  calendarStep         Int                @default(1)
  createdAt            DateTime           @default(now())

  user                 User               @relation(fields: [userId], references: [id])
  generatedContents    GeneratedContent[]
}

model GeneratedContent {
  id            String         @id @default(cuid())
  influencerId  String
  imageUrl      String?
  caption       String?
  errorMessage  String?
  platform      ContentPlatform @default(INSTAGRAM)
  format        ContentFormat
  status        ContentStatus   @default(PENDING)
  scheduledAt   DateTime?
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())

  influencer    Influencer     @relation(fields: [influencerId], references: [id])
}
