generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  SOLO
  STUDIO
  AGENCY
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  plan      Plan      @default(SOLO)
  createdAt DateTime  @default(now())
  personas  Persona[]
}

model Persona {
  id              String   @id @default(cuid())
  userId          String
  name            String
  niche           String
  narrativeStyle  String
  tones           String[]
  pillars         Json
  narrativeMemory Json
  createdAt       DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  batches Batch[]
}

model Batch {
  id             String   @id @default(cuid())
  personaId      String
  arcType        String
  arcDescription String
  createdAt      DateTime @default(now())

  persona Persona @relation(fields: [personaId], references: [id])
  posts   Post[]
}

model Post {
  id           String @id @default(cuid())
  batchId      String
  arcPosition  Int
  pillar       String
  arcTypeLocal String
  format       String
  body         String

  batch Batch @relation(fields: [batchId], references: [id])
}
