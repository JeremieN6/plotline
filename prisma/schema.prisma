generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  SOLO
  STUDIO
  AGENCY
}

enum AccountType {
  INFLUENCER_CREATOR
  CONTENT_CREATOR
  BRAND
}

enum ContentPlatform {
  INSTAGRAM
  TIKTOK
  BOTH
}

enum ContentFormat {
  FEED
  STORY
  REEL
}

enum ContentStatus {
  PROCESSING
  PENDING
  VALIDATED
  PUBLISHED
  REJECTED
  FAILED
}

enum SilhouetteType {
  SLIM
  ATHLETIC
  CURVY
  VOLUPTUOUS
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String?
  plan         Plan          @default(SOLO)
  accountType  AccountType?
  createdAt    DateTime      @default(now())
  influencers  Influencer[]
  authSessions AuthSession[]
  passwordResetTokens PasswordResetToken[]
  emailChangeTokens   EmailChangeToken[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailChangeToken {
  id        String   @id @default(cuid())
  userId    String
  newEmail  String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([newEmail])
  @@index([expiresAt])
}

model Influencer {
  id                   String             @id @default(cuid())
  userId               String
  name                 String
  niche                String
  style                String
  silhouette           SilhouetteType     @default(VOLUPTUOUS)
  faceRefPath          String?
  bodyPrompt           String?
  hairPrompt           String?
  identityProfile      String             @default("default")
  instagramAccountId   String?
  instagramAccessToken  String?
  twitterConnected     Boolean            @default(false)
  twitterUsername      String?
  tiktokEnabled        Boolean            @default(false)
  calendarStep         Int                @default(1)
  createdAt            DateTime           @default(now())

  user                 User               @relation(fields: [userId], references: [id])
  generatedContents    GeneratedContent[]
}

model GeneratedContent {
  id            String         @id @default(cuid())
  influencerId  String
  imageUrl      String?
  caption       String?
  errorMessage  String?
  platform      ContentPlatform @default(INSTAGRAM)
  format        ContentFormat
  status        ContentStatus   @default(PENDING)
  scheduledAt   DateTime?
  publishedAt   DateTime?
  twitterPublishedAt DateTime?
  createdAt     DateTime       @default(now())

  influencer    Influencer     @relation(fields: [influencerId], references: [id])
}
