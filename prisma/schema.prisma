generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  SOLO
  STUDIO
  AGENCY
}

enum AccountType {
  INFLUENCER_CREATOR
  CONTENT_CREATOR
  BRAND
}

enum ProfileType {
  PERSONA
  BRAND
  ACTIVITY
}

enum ContentPlatform {
  INSTAGRAM
  TIKTOK
  BOTH
}

enum ContentFormat {
  FEED
  STORY
  REEL
}

enum ContentStatus {
  PROCESSING
  PENDING
  VALIDATED
  PUBLISHED
  REJECTED
  FAILED
}

enum SilhouetteType {
  SLIM
  ATHLETIC
  CURVY
  VOLUPTUOUS
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String?
  plan         Plan          @default(SOLO)
  accountType  AccountType?
  createdAt    DateTime      @default(now())
  influencers  Profile[]
  campaigns    Campaign[]
  authSessions AuthSession[]
  passwordResetTokens PasswordResetToken[]
  emailChangeTokens   EmailChangeToken[]
}

model Campaign {
  id         String   @id @default(cuid())
  userId     String
  name       String
  objective  String?
  channel    String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedContents GeneratedContent[]

  @@index([userId, createdAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailChangeToken {
  id        String   @id @default(cuid())
  userId    String
  newEmail  String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([newEmail])
  @@index([expiresAt])
}

model Profile {
  id                   String             @id @default(cuid())
  userId               String
  name                 String
  niche                String
  style                String
  profileType          ProfileType?
  silhouette           SilhouetteType     @default(VOLUPTUOUS)
  brandId              String?
  faceRefPath          String?
  bodyPrompt           String?
  hairPrompt           String?
  identityProfile      String             @default("default")
  description          String?
  website              String?
  targetAudience       String?
  instagramAccountId   String?
  instagramAccessToken  String?
  twitterConnected     Boolean            @default(false)
  twitterUsername      String?
  tiktokEnabled        Boolean            @default(false)
  calendarStep         Int                @default(1)
  createdAt            DateTime           @default(now())

  user                 User               @relation(fields: [userId], references: [id])
  brand                Profile?           @relation("ProfileBrand", fields: [brandId], references: [id], onDelete: SetNull)
  brandInfluencers     Profile[]          @relation("ProfileBrand")
  generatedContents    GeneratedContent[]

  @@map("Influencer")
}

model GeneratedContent {
  id            String         @id @default(cuid())
  influencerId  String
  brandId       String?
  ambassadorId  String?
  campaignId    String?
  imageUrl      String?
  caption       String?
  prompt        String?
  errorMessage  String?
  platform      ContentPlatform @default(INSTAGRAM)
  format        ContentFormat
  status        ContentStatus   @default(PENDING)
  scheduledAt   DateTime?
  publishedAt   DateTime?
  twitterPublishedAt DateTime?
  createdAt     DateTime       @default(now())

  influencer    Profile        @relation(fields: [influencerId], references: [id])
  campaign      Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  versions      ContentVersion[]
}

/// Historique des rendus successifs d un contenu.
/// GeneratedContent conserve toujours l etat courant (imageUrl/caption/prompt),
/// ce qui evite de toucher au code de publication et de listing. ContentVersion
/// stocke un instantane complet de chaque rendu pour permettre le retour arriere.
model ContentVersion {
  id              String   @id @default(cuid())
  contentId       String
  imageUrl        String?
  caption         String?
  prompt          String?
  generationModel String?
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())

  content         GeneratedContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, createdAt])
}
